SMS_KUB_API_KEY=zOTXEFieLOUfoT1wx3VgZBHjD3YVz2PA
SMS_KUB_SENDER=SUITCUBE

# PIN หลังบ้านสำหรับแก้ข้อความและทดลองส่ง SMS — ควรเปลี่ยนจาก 1234 ก่อนใช้งานจริง
SUITCUBE_ADMIN_PIN=1234

# ไม่บังคับ: ตำแหน่งไฟล์เก็บข้อความ SMS (ค่าเริ่มต้นอยู่ข้าง suitcube-api.js)
# SMS_SETTINGS_FILE=/path/to/persistent/suitcube-sms-settings.json

# เปิดระบบแจ้งเตือน (คิววันนี้ส่งทันที / คิวอื่นส่งเมื่อเหลือไม่เกิน 24 ชั่วโมง)
SMS_REMINDER_ENABLED=true

# ตรวจคิวทุก 5 นาที
SMS_REMINDER_INTERVAL_MS=300000

# หากส่งไม่สำเร็จ ให้ลองใหม่ทุก 60 นาที สูงสุด 3 ครั้ง
SMS_REMINDER_RETRY_MINUTES=60
SMS_REMINDER_MAX_ATTEMPTS=3
