# SMS-KUB — ใส่ค่าจริงในไฟล์ .env ของ server แล้ว restart
# ห้ามนำ API Key ไปใส่ในไฟล์ HTML หรือ JavaScript ฝั่งหน้าเว็บ
SMS_KUB_API_KEY=
SMS_KUB_SENDER=SUITCUBE

# เปิดระบบแจ้งเตือนก่อนคิว 24 ชั่วโมง
SMS_REMINDER_ENABLED=true

# ตรวจคิวทุก 5 นาที
SMS_REMINDER_INTERVAL_MS=300000

# หากส่งไม่สำเร็จ ให้ลองใหม่ทุก 60 นาที สูงสุด 3 ครั้ง
SMS_REMINDER_RETRY_MINUTES=60
SMS_REMINDER_MAX_ATTEMPTS=3
